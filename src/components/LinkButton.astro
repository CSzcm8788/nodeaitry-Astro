---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled, class: className, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
// Keep intentional mail links usable without Cloudflare's client-side decoder.
const isMailLink = !disabled && String(attrs.href ?? "").startsWith("mailto:");
---

<Fragment set:html={isMailLink ? "<!--email_off-->" : ""} />
<Button
  aria-disabled={disabled}
  class:list={[
    "group inline-flex items-center gap-1",
    { "hover:text-accent": !disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
<Fragment set:html={isMailLink ? "<!--/email_off-->" : ""} />
